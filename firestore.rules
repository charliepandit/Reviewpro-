rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Clients: public read, authenticated write/delete
    match /clients/{clientId} {
      allow read: if true;
      allow create, write, delete: if request.auth != null;
    }

    // Reviews: public create (customers), authenticated read
    match /reviews/{reviewId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Subscriptions: authenticated only
    match /subscriptions/{docId} {
      allow read, write, delete: if request.auth != null;
    }

    // Coupons: public read, authenticated write/delete
    match /coupons/{couponId} {
      allow read: if true;
      allow create, write, delete: if request.auth != null;
    }

    // Notifications: authenticated only
    match /notifications/{docId} {
      allow read, write, delete: if request.auth != null;
    }

    // OTP logs: authenticated only
    match /otpLogs/{docId} {
      allow read, write, delete: if request.auth != null;
    }

    // Place IDs: public read, authenticated write/delete
    match /placeIds/{docId} {
      allow read: if true;
      allow create, write, delete: if request.auth != null;
    }

    // Analytics: authenticated write
    match /analytics/{docId} {
      allow read, write, delete: if request.auth != null;
    }

    // Plan settings: authenticated write
    match /planSettings/{docId} {
      allow read: if true;
      allow write, delete: if request.auth != null;
    }

    // Review settings: authenticated write
    match /reviewSettings/{docId} {
      allow read, write, delete: if request.auth != null;
    }

    // Review history: authenticated only
    match /reviewHistory/{docId} {
      allow read, write, delete: if request.auth != null;
    }

    // QR codes: authenticated only
    match /qrCodes/{docId} {
      allow read, write, delete: if request.auth != null;
    }

    // Everything else: authenticated only
    match /{document=**} {
      allow read, write, delete: if request.auth != null;
    }

  }
}
